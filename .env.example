# =============================================================================
# .env.example — copy to .env and fill in. NEVER commit the real .env.
# =============================================================================

# --- Mode -------------------------------------------------------------------
# global kill: if false, no live orders submit even if a strategy says live
LIVE_TRADING_ENABLED=false
ENVIRONMENT=development  # development | staging | production

# --- Polymarket -------------------------------------------------------------
# Use a HOT WALLET dedicated to this bot. Funded with ONLY what you can lose.
# Cold wallet stays in hardware. Never the same key.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=
POLYMARKET_SIGNATURE_TYPE=1   # 0=EOA(MetaMask), 1=Magic/email, 2=browser proxy
POLYMARKET_HOST=https://clob.polymarket.com
POLYMARKET_GAMMA_HOST=https://gamma-api.polymarket.com
POLYMARKET_CHAIN_ID=137       # 137=Polygon mainnet, 80002=Amoy testnet

# --- Solana -----------------------------------------------------------------
# SEPARATE hot wallet from Polymarket. Different blast radius.
SOLANA_PRIVATE_KEY=                          # base58 encoded
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com  # use a paid RPC for real use
JUPITER_API_HOST=https://quote-api.jup.ag/v6

# --- Robinhood Chain (EIP-155 4663) ---------------------------------------
# Hex private key for 0x4D772dB54461eAc90538d6c1E336841f4ACbD91c.
# Never paste this in chat. Must match RH_EXPECTED_ADDRESS in whale_config.
EVM_PRIVATE_KEY=
ZERO_EX_API_KEY=                   # https://dashboard.0x.org/apps
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# --- External data ----------------------------------------------------------
NEWS_API_KEY=                  # newsapi.org or alternative
ODDS_API_KEY=                  # the-odds-api.com (sportsbook odds for arb)
KALSHI_API_KEY=                # kalshi.com (for cross-platform arb)
KALSHI_API_SECRET=
DUNE_API_KEY=                  # dune.com (whale identification queries)

# --- LLM (for news_event strategy) ------------------------------------------
ANTHROPIC_API_KEY=

# --- Persistence ------------------------------------------------------------
# SQLite is default for easy local dev — no Docker, no service to start.
# For production / multi-process / heavier use, switch to Postgres:
#   DATABASE_URL=postgresql://trader:trader@localhost:5432/trading_bot
DATABASE_URL=sqlite:///./trading_bot.db

# --- Monitoring + alerts ----------------------------------------------------
TELEGRAM_BOT_TOKEN=            # @BotFather token; never commit
TELEGRAM_CHAT_ID=              # filled by: python scripts/setup_telegram.py
TELEGRAM_OPERATOR_ID=          # your numeric user id; only this id can HALT/RESUME
DISCORD_WEBHOOK_URL=           # for fills, alerts, kill switch events
LOG_LEVEL=INFO

# --- Risk limits (hard caps; strategies cannot exceed) ----------------------
MAX_POSITION_USD=50            # per single market
MAX_TOTAL_EXPOSURE_USD=500     # across all open positions
MAX_DAILY_LOSS_USD=100         # bot disables itself if breached
MAX_OPEN_POSITIONS=20
KILL_ON_DAILY_LOSS=true
